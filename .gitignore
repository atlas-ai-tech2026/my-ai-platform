node_modules/
dist/
.env
.env.local
server/.env
server/node_modules/
server/data/
*.log
.DS_Store

# Claude Code's local agent scratch — worktrees, machine-local settings, plans.
# N18 (recheck 2026-08-03): this used to ignore ALL of .claude/, while 52 files
# under it were already tracked — .gitignore does not untrack what is already
# committed, so the stated rule was simply untrue. Reviewed the contents: they
# are skill definitions and launch.json, i.e. deliberate portable tooling, not
# scratch, and none of it contains secrets. So the rule is narrowed to match the
# intent rather than deleting files that are working.
.claude/*
!.claude/skills/
!.claude/launch.json
.claude/settings.local.json
.claude/plans/
.claude/worktrees/
.claude/sessions/
.claude/**/settings.local.json

# Sensitive business documents — must NEVER be committed to this PUBLIC repo.
*.pdf
digitalocean-support-ticket.md

# C2 (security audit 2026-07-28): customer-data spreadsheets must NEVER
# reach this PUBLIC repo. Export scripts write into reports/ (ignored).
*.xlsx
*.xls
*.csv
reports/

# Source/code archives (e.g. _audit_code.tar.gz — a full snapshot of the
# repo made for the security audit). Never belongs in a PUBLIC repo: it is
# redundant with git itself and one `git add .` from being published.
*.tar.gz
*.tgz
*.zip

# Local-only assets / generated media and admin recovery scripts.
cameras voxel/
images/
server/scripts/

# N16 (recheck 2026-08-03): internal unit-economics workbooks and one-off
# report tooling. Voxel_Credit_Calculator.html carries per-supplier costs
# and margin formulas — untracked but, until now, not ignored, so a single
# `git add .` would have published it from this PUBLIC repo.
Voxel_Credit_Calculator.html
SPA_REPORT_README.md
