# ═══════════════════════════════════════════════════════════════════
#  LOCAL DEVELOPMENT ONLY — NOT DEPLOYED
#  Production serves the SPA from Express via the DigitalOcean Node
#  buildpack (.do/app.yaml). nginx never runs in production, so any
#  header set in nginx.conf would NOT apply there — put security
#  headers in the Helmet config in server/src/index.js instead.
#  (M4, security audit 2026-07-28.)
# ═══════════════════════════════════════════════════════════════════
# ─── VOXEL.AI frontend (Vite build → nginx) ─────────────────────

# Stage 1: build
FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# Stage 2: serve
# H6 (security audit 2026-07-28): nginx-unprivileged runs as uid 101 with no
# root master process, and already expects a >1024 port and a writable
# /tmp for its pid + temp paths. Our config already listens on 8080, so this
# is a drop-in swap for the root-running nginx image.
FROM nginxinc/nginx-unprivileged:1.27-alpine

# Copying as root would leave root-owned files an unprivileged worker can
# still read (0644), but be explicit about ownership anyway.
COPY --from=build --chown=nginx:nginx /app/dist /usr/share/nginx/html
# Build context is the repo root, so this file is addressed from there.
COPY --chown=nginx:nginx local-dev/nginx.conf /etc/nginx/conf.d/default.conf

# uid 101 = `nginx` in this image. Stated explicitly so a future base-image
# change can't silently promote us back to root.
USER 101

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
